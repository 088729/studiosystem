# Studio MCP Server — example configuration.
# All values here are placeholders: localhost / example.com only.
# Copy to .env and fill in real values; .env must never be committed.

# --- Backend ---
# Backend base URL, WITHOUT /api/v1. Point at your own instance.
STUDIO_BASE_URL=http://127.0.0.1:8302

# --- Auth (pick one mode) ---
# password | bearer | pat (pat requires a future backend release)
STUDIO_MCP_AUTH_MODE=password
STUDIO_MCP_USERNAME=mcp-bot
STUDIO_MCP_PASSWORD=change-me
# STUDIO_MCP_TOKEN=
# STUDIO_MCP_TOKEN_FILE=/path/to/token.txt
# STUDIO_MCP_PAT=

# --- Transport ---
# stdio | http
STUDIO_MCP_TRANSPORT=stdio
STUDIO_MCP_HOST=127.0.0.1
STUDIO_MCP_PORT=8303
# Outer bearer token for HTTP transport. Empty = loopback-only + warning.
# STUDIO_MCP_MCP_TOKEN=

# --- Capability domains ---
# case,task,wiki,focus,habits,analytics,git,collab,admin,workflow,scheduler
STUDIO_MCP_MODULES=case,task,wiki
# true = register read-only tools only; write tools never appear
STUDIO_MCP_READ_ONLY=false
# STUDIO_MCP_ALLOWED_TOOLS=case_get_map,task_list_tasks
# STUDIO_MCP_DENIED_TOOLS=
# auto | token | none
STUDIO_MCP_CONFIRM_MODE=auto
STUDIO_MCP_ALLOW_DESTRUCTIVE=false
# Admin domain (user/role/permission management). Off by default; requires
# READ_ONLY=false and backend sys:manage permission.
STUDIO_MCP_ALLOW_ADMIN=false
# Token-bucket rate limit on tool calls per minute (per identity); <=0 = off
STUDIO_MCP_RATE_LIMIT_PER_MINUTE=30

# --- Protocol ---
# Versions declared in server/discover, in preference order
STUDIO_MCP_PROTOCOL_VERSIONS=2026-07-28,2025-11-25
STUDIO_MCP_TOOL_TTL_MS=60000

# --- Behavior ---
# published | draft — default source when reading a mind map
STUDIO_MCP_CASE_SOURCE=published
# STUDIO_MCP_DEFAULT_VAULT_ID=
STUDIO_MCP_DEFAULT_WIKI_PATH=reports/{date}.md
# STUDIO_MCP_TEMPLATES_DIR=/path/to/templates
STUDIO_MCP_TIMEOUT=15
STUDIO_MCP_RETRY=2
STUDIO_MCP_TZ_OFFSET_MINUTES=480
STUDIO_MCP_MAX_RESULT_ITEMS=20

# --- Logging / audit ---
# stdio mode logs to stderr only; stdout must stay protocol-clean
STUDIO_MCP_LOG_LEVEL=INFO
# STUDIO_MCP_AUDIT_FILE=/path/to/audit.jsonl
