# MongoDB
MONGODB_URI=mongodb://localhost:27017/studio_system

# JWT
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=120

# 文件存储：local（默认，本地磁盘，经 /uploads 访问）| s3（S3 兼容云）| resourceplatform（自建文件服务）
STORAGE_BACKEND=local
STORAGE_DIR=./data/uploads

# —— STORAGE_BACKEND=s3 时的 S3 兼容配置（覆盖 AWS S3 / 阿里云 OSS / 腾讯云 COS / 七牛 / 华为 OBS / MinIO / R2）——
# STORAGE_S3_ENDPOINT_URL / STORAGE_S3_ACCESS_KEY / STORAGE_S3_SECRET_KEY / STORAGE_S3_BUCKET
# STORAGE_S3_ADDRESSING=auto|path|virtual；STORAGE_S3_PUBLIC_BASE=桶的公共域名（推荐公共读桶，留空则 7 天预签名）
# 常用云 endpoint 预设：
#   阿里云 OSS  https://oss-cn-hangzhou.aliyuncs.com      （region 按地域替换）
#   腾讯云 COS  https://cos.ap-shanghai.myqcloud.com
#   七牛 Kodo   https://s3.cn-east-1.qiniucs.com
#   华为云 OBS  https://obs.cn-north-4.myhuaweicloud.com
#   MinIO      http://your-nas:9000
#   AWS S3     留空（默认 aws 端点）
#STORAGE_BACKEND=s3
#STORAGE_S3_ENDPOINT_URL=https://oss-cn-hangzhou.aliyuncs.com
#STORAGE_S3_ACCESS_KEY=your-access-key
#STORAGE_S3_SECRET_KEY=your-secret-key
#STORAGE_S3_BUCKET=studio-system
#STORAGE_S3_REGION=cn-hangzhou
#STORAGE_S3_ADDRESSING=virtual
#STORAGE_S3_PUBLIC_BASE=https://studio-system.oss-cn-hangzhou.aliyuncs.com

# 仅 STORAGE_BACKEND=resourceplatform 时生效
RESOURCEPLATFORM_BASE_URL=http://localhost:9000
RESOURCEPLATFORM_TOKEN=change-me

# CORS (comma separated origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# App
APP_NAME=Studio System Backend
DEBUG=true
