apiVersion: v1
kind: Secret
metadata:
  name: studiosystem-secret
  namespace: studio
type: Opaque
stringData:
  # 随机 64 位 hex（python -c "import secrets; print(secrets.token_hex(32))"）
  SECRET_KEY: "changeme"
  # 与 resourceplatform-secret 的 STATIC_API_TOKEN 保持一致
  RESOURCEPLATFORM_TOKEN: "changeme"
